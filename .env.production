# Production build (npm run build) — overrides .env.
# Lead forms post to the same domain (https://focasedu.com/api/...), which nginx
# proxies to focas-lead-server. Never point this at localhost for a live build.
VITE_COUNSELING_API=

# Follow-up dashboard web-lead endpoint. FS, counselling, manual, RTI and audit
# forms send it a copy of each lead (with UTMs). Empty = tracking off.
VITE_LEAD_TRACK_URL=https://beta.focasedu.online/api/leads/web
