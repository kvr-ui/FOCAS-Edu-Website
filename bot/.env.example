# Copy to bot/.env and fill in. bot/.env is gitignored - never commit real values.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-botfather
# Telegram user IDs allowed to use the bot (comma-separated). Anyone else is ignored
# silently. Find an ID by messaging @userinfobot. The owner is always allowed.
TELEGRAM_ALLOWED_IDS=111111111,222222222
# The only user who can `ok` / `/deploy` / `/rollback`.
TELEGRAM_OWNER_ID=111111111
# Optional: how the owner is named in refusals ("Only <name> can deploy").
TELEGRAM_OWNER_NAME=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Vercel (preview deployments) --------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_...
# Optional: only for projects owned by a Vercel team.
VERCEL_TEAM_ID=

# --- Repo & production ---------------------------------------------------------
# Absolute path of the bot's OWN git checkout of this repo (not the checkout the bot runs from).
REPO_DIR=/srv/focas-lp/repo
# nginx web root that production builds are atomically swapped into.
WEB_ROOT=/var/www/focas
# Public site origin (no trailing slash).
SITE_URL=https://focasedu.com

# Optional: where the bot keeps its JSON state (relative paths are resolved from bot/).
# Default: bot/data
BOT_STATE_DIR=
