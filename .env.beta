# Beta build (npm run build:beta → vite build --mode beta) for main.focasedu.online.
# Vite loads .env.beta instead of .env.production in this mode, so every value
# the site needs is repeated here. Never use this file for the live site.
VITE_COUNSELING_API=https://leads.focasedu.online

# Follow-up dashboard web-lead endpoint. Empty = tracking off.
VITE_LEAD_TRACK_URL=https://beta.focasedu.online/api/leads/web

VITE_BACKEND_URL=https://api.focasedu.com
VITE_RTI_BACKEND_URL=https://backend.focasedu.com

# Razorpay TEST key id (public; pay with UPI success@razorpay). Never put the key secret here.
VITE_RAZORPAY_KEY_ID=rzp_test_SYBepV88dkOJSb
